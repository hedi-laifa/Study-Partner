# =============================================================================
# Study Partner AI — Environment Configuration Template
# Copy this file to .env and adjust values as needed for your local setup.
# =============================================================================

# --- Application Settings ---
APP_NAME="Study Partner AI"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- PostgreSQL Database ---
POSTGRES_USER=studypartner
POSTGRES_PASSWORD=studypartner_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=study_partner_db
DATABASE_URL=postgresql+psycopg://studypartner:studypartner_dev_password@localhost:5432/study_partner_db

# --- ChromaDB Vector Store ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=../storage/chroma
CHROMA_COLLECTION_NAME=study_partner_chunks

# --- Local File Storage ---
UPLOAD_STORAGE_DIR=../storage/uploads
MAX_UPLOAD_SIZE_MB=50

# --- AI & Embeddings (Ollama + Sentence Transformers) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30.0
TUTOR_OFFLINE_FALLBACK=false
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.18

# --- Authentication & Security ---
AUTH_SECRET_KEY=replace-with-a-strong-32-byte-secret-in-production
AUTH_TOKEN_TTL_MINUTES=480
AUTH_REQUIRED=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
